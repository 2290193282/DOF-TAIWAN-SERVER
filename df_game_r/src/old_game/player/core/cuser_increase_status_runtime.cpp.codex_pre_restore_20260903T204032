        }
        break;
    case 21: {
        const int coin = getCurCharacInvenR()->GetCoin() + value;
        getCurCharacInvenW()->SetCoin(coin);
        history_log().CoinAdd(getCurCharacInvenR()->GetCoin(),
                              value,
                              static_cast<eCoinAddReason>(3));
        SendUpdateItemList(static_cast<eSendTarget>(1),
                           static_cast<ENUM_ITEMSPACE>(0),
                           1);
        break;
    }
    case 22: ResetPvpSkills(this, value == 1); break;
    case 23: {
        CPremiumLetheManager* const lethe =
            G_CGameManager()->GetPremiumLetheManager();
        const int skill_tree = GetCurCharacSkillTreeIndex();
        const int charac_no = getCurCharacNo();
        const char* const charac_name = getCurCharacName();
        cMyTrace trace("void CUser::increase_status(short int)", 19466, 0);
        trace("ONE_DAY_LETHE : BUY_SKILL_CONFIRM_TICKET, char(%s), char_no(%d), style(%d)",
              charac_name,
              charac_no,
              skill_tree);
        if (lethe) {
            lethe->ConfirmSkillReq(this);
        }
        break;
    }
    case 25:
        getCurCharacInvenW()->avatar_coin_.Add(static_cast<unsigned int>(value));
        AvatarCoin::SaveToDB(this);
        AvatarCoin::SendSyncPacket(this);
        AvatarCoin::HistoryLog::AddLog(this, static_cast<unsigned int>(value));
        break;
    default:
        break;
    }

    SendCompletionAndBroadcast(this, packet, slot, status, value);
}
