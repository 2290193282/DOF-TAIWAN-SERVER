const ENUM_SKILL_TREE_KIND kFirstSkillTree = ENUM_SKILL_TREE_0;
const ENUM_SKILL_TREE_KIND kSecondSkillTree = ENUM_SKILL_TREE_1;

void SendStatusPacket(CUser* user,
                      PacketGuard& packet,
                      short slot,
                      int status,
                      int value,
                      short previous_level = 0,
                      short gained_level = 0) {
    packet.clear();
    packet.put_header(1, ENUM_CMDPACKET_INCREASE_STATUS);
    packet.put_byte(1);
    packet.put_short(slot);
    packet.put_byte(status);
    packet.put_int(value);
    packet.put_short(previous_level);
    packet.put_short(gained_level);
    packet.finalize(true);
    user->Send(packet);
}

void SendBasicInfo(CUser* user, PacketGuard& packet) {
    packet.clear();
    packet.put_header(0, 2);
    packet.put_byte(1);
    packet.put_short(1);
    user->make_basic_info(packet, 1);
    packet.finalize(true);
}

void SendCompletionAndBroadcast(CUser* user,
                                PacketGuard& packet,
                                short slot,
                                int status,
                                int value) {
    SendStatusPacket(user, packet, slot, status, value);

    if (user->get_state() == 5) {
        CParty* const party = user->GetParty();
        if (party) {
            SendBasicInfo(user, packet);
            party->send_to_party(packet);
        }
    } else if (user->get_state() == 8) {
        WarRoom* const room = user->GetWarRoom();
        if (room) {
            SendBasicInfo(user, packet);
            room->SendToRoom(packet);
        }
    }
}

bool ApplyGiveSkills(CUser* user,
                     ENUM_SKILL_TREE_KIND first_tree,
                     ENUM_SKILL_TREE_KIND second_tree,
                     bool both_trees,
                     int changer_target,
                     int status_for_log) {
    CCharacList* const character_list = G_CDataManager()->get_character_list();
    CCharacter* const character =
        &character_list->characters_[user->get_charac_job()];
    std::vector<std::pair<int, int> > skills;
    if (character->get_give_skill(user->getCurCharFirstGrowType(),
                                  user->getCurCharSecondGrowType(),
                                  skills,
                                  0) != 1) {
        LogManager::logFormat(
            1,
            "user.cpp",
            "void CUser::increase_status(short int)",
            both_trees ? 0x4aee : 0x4b48,
            "User %s - CUser::set_grow_type %d",
            user->getCurCharacName(),
            status_for_log);
        return false;
    }

    SkillSlot* const skill_slot = user->getCurCharacSkillW();
    for (std::vector<std::pair<int, int> >::const_iterator iter =
             skills.begin();
         iter != skills.end();
         ++iter) {
        skill_slot->growtype_skill(user->get_charac_job(),
                                   iter->first,
                                   iter->second,
                                   first_tree);
        if (both_trees) {
            skill_slot->growtype_skill(user->get_charac_job(),
                                       iter->first,
                                       iter->second,
                                       second_tree);
        }
    }

    STExpertJobScript* const expert_job = G_CDataManager()->GetExpertJobScript(
        user->GetCurCharacExpertJobType());
    if (expert_job) {
        for (std::vector<std::pair<int, int> >::const_iterator iter =
                 expert_job->unknown_exp_pairs.begin();
             iter != expert_job->unknown_exp_pairs.end();
             ++iter) {
            const int level = user->GetCurExpertJobLevel(
                user->GetCurCharacExpertJobExp());
            skill_slot->growtype_skill(user->get_charac_job(),
                                       iter->first,
                                       level,
                                       first_tree);
            if (both_trees) {
                skill_slot->growtype_skill(user->get_charac_job(),
                                           iter->first,
                                           level,
                                           second_tree);
            }
        }
    }

    WongWork::CSkillChanger skill_changer;
    skill_changer.SkillInitialize(user, changer_target, false);
    user->send_skill_info();
    return true;
}

void UpdateLetheState(CUser* user,
                      CPremiumLetheManager* lethe,
                      bool both_trees,
                      ENUM_SKILL_TREE_KIND tree) {
    if (!lethe) {
        return;
    }
    if (user->isAffectedPremium(kOneDayLethePremium)) {
        if (both_trees) {
            lethe->InitLetheSkill(user, kFirstSkillTree);
            lethe->InitLetheSkill(user, kSecondSkillTree);
        } else {
            lethe->InitLetheSkill(user, tree);
        }
        return;
    }
    if (both_trees) {
        lethe->UpdateBackupSkillFlag(user, kFirstSkillTree);
        lethe->UpdateBackupSkillFlag(user, kSecondSkillTree);
    } else {
        lethe->UpdateBackupSkillFlag(user, tree);
    }
}

bool ResetNormalSkills(CUser* user, bool both_trees, int status_for_log) {
    SkillSlot* const skill_slot = user->getCurCharacSkillW();
    const ENUM_SKILL_TREE_KIND current_tree = static_cast<ENUM_SKILL_TREE_KIND>(
        user->GetCurCharacSkillTreeIndex());
    const ENUM_SKILL_TREE_KIND target_tree =
        current_tree == ENUM_SKILL_TREE_CURRENT || current_tree == kFirstSkillTree
            ? kFirstSkillTree
            : kSecondSkillTree;

    if (both_trees) {
        skill_slot->clear_all_skills_both();
        skill_slot->set_parent(user);
        addSkillOnCreateCharacter(
            skill_slot->get_mastered_skill_tree(kFirstSkillTree),
            user->get_charac_job());
        addSkillOnCreateCharacter(
            skill_slot->get_mastered_skill_tree(kSecondSkillTree),
            user->get_charac_job());
    } else {
        skill_slot->clear_all_skills(target_tree);
        skill_slot->set_parent(user);
        addSkillOnCreateCharacter(skill_slot->get_mastered_skill_tree(target_tree),
                                  user->get_charac_job());
    }

    const int changer_target = both_trees ? 0 :
        (target_tree == kFirstSkillTree ? 1 : 2);
    if (!ApplyGiveSkills(user,
                         both_trees ? kFirstSkillTree : target_tree,
                         kSecondSkillTree,
                         both_trees,
                         changer_target,
                         status_for_log)) {
        return false;
    }

    CPremiumLetheManager* const lethe =
        G_CGameManager()->GetPremiumLetheManager();
    UpdateLetheState(user, lethe, both_trees, target_tree);
    return true;
}

void ResetPvpSkills(CUser* user, bool both_trees) {
    SkillSlot* const skill_slot = user->getCurCharacSkillW();
    const ENUM_SKILL_TREE_KIND current_tree = static_cast<ENUM_SKILL_TREE_KIND>(
        user->GetCurCharacSkillTreeIndex());
    const ENUM_SKILL_TREE_KIND target_tree =
        current_tree == ENUM_SKILL_TREE_CURRENT || current_tree == kFirstSkillTree
            ? kFirstSkillTree
            : kSecondSkillTree;
    if (both_trees) {
        skill_slot->clear_all_skills_both();
        skill_slot->set_parent(user);
        user->givePvPSkillTree(0, true, 3);
    } else {
        skill_slot->clear_all_skills(target_tree);
        skill_slot->set_parent(user);
        user->givePvPSkillTree(0,
                               true,
                               target_tree == kFirstSkillTree ? 1 : 2);
    }

    const int pvp_skill_point =
        G_CDataManager()->get_pvp_skill_tree_parameter_script()
            ->getPvPSkillPoint(user->get_charac_job(),
                               user->getCurCharFirstGrowType(),
                               user->getCurCharSecondGrowType(),
                               user->get_pvp_grade(),
                               false);
    if (both_trees) {
        skill_slot->set_remain_sp_at_index(pvp_skill_point, kFirstSkillTree);
        skill_slot->set_remain_sp_at_index(pvp_skill_point, kSecondSkillTree);
    } else {
        skill_slot->set_remain_sp_at_index(pvp_skill_point, target_tree);
    }
    user->send_skill_info();
    UpdateLetheState(user,
                     G_CGameManager()->GetPremiumLetheManager(),
                     both_trees,
                     target_tree);
}

void SendUseStatusError(CUser* user,
                        PacketGuard& packet,
                        unsigned char error) {
    user->SendCmdErrorPacket(kUseStatusCommand, error, packet);
}

