        AddTournamentMonster(infos[opponent], monsters, round == 4);
    }

    int sequence = 0;
    for (std::list<_mapMonster>::iterator it = monsters.begin();
         it != monsters.end();
         ++it) {
        it->raw_2c = sequence++;
