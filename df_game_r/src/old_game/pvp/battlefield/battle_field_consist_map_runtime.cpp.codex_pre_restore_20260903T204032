            if (attempted_count < existing_monster_count) {
                monster.map_monster_unique_id_ =
                    next_unique_id++;
                GetCurrentMapInfo()->Add_Mob(monster);
                ++spawn_sequence;
                if (spawn_sequence >=
                    map->event_monster_positions_.size() + 10000u) {
                    spawn_sequence = 10000;
