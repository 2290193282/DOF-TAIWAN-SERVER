enum MissionType {
    MISSION_HIDDEN_MONSTER = 0,
    MISSION_TREASURE_BOX = 1,
    MISSION_SECRET_PATH = 2,
    MISSION_TIME_ATTACK = 3,
    MISSION_BOSS_ATTACK = 4
};

